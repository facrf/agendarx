# Imagem publicada por https://github.com/facrf/agendarx.
AGENDARX_IMAGE=ghcr.io/facrf/agendarx:latest
AGENDARX_PORT=12000

# Gere com: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-aleatorio-com-64-caracteres
ADMIN_LOGIN=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte

JWT_TTL_MINUTES=480
COOKIE_SECURE=false
MAX_UPLOAD_BYTES=26214400

# A Stack inclui uma instância SearXNG privada. Gere o segredo como o JWT_SECRET.
SEARXNG_IMAGE=docker.io/searxng/searxng:latest
SEARXNG_SECRET=troque-por-outro-segredo-aleatorio-com-64-caracteres

# Deixe vazio para usar o SearXNG da Stack ou informe uma instância externa com JSON.
SEARXNG_URL=
OSINT_TIMEOUT_SECONDS=20
OSINT_MAX_RESULTS=15
OSINT_MAX_PDF_BYTES=20971520
RUST_LOG=agendarx=info,tower_http=info
