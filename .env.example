SERVER_ADDR=0.0.0.0:12000
DATABASE_URL=sqlite://data/agendarx.db?mode=rwc
JWT_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres
# Somente em desenvolvimento local: permite omitir JWT_SECRET usando segredo público.
ALLOW_INSECURE_DEV_JWT=false
JWT_TTL_MINUTES=480
MAX_UPLOAD_BYTES=26214400
TASK_STORAGE_PER_TASK_BYTES=104857600
TASK_STORAGE_QUOTA_BYTES=1073741824
BACKUP_MAX_UPLOAD_BYTES=5368709120
FRONTEND_DIR=frontend/dist
# Defina como true em producao com terminacao TLS/HTTPS no proxy reverso.
COOKIE_SECURE=false

# Instância SearXNG com o formato JSON habilitado (a URL pode conter um subcaminho).
# SEARXNG_URL=https://searxng.exemplo.org
# Chave opcional para ampliar os limites da API do OpenAlex.
# OPENALEX_API_KEY=
# Credenciais necessárias somente para pesquisas no INLABS / DOU.
# INLABS_USERNAME=usuario@exemplo.com
# INLABS_PASSWORD=troque-esta-senha
INLABS_LOOKBACK_DAYS=1
OSINT_TIMEOUT_SECONDS=20
OSINT_MAX_RESULTS=15
OSINT_MAX_PDF_BYTES=20971520

# Usados somente para criar o primeiro usuário, caso ainda não existam usuários.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=troque-esta-senha

RUST_LOG=agendarx=info,tower_http=info

# Opcional: substitui a chave pública do CNJ quando houver rotação.
# https://datajud-wiki.cnj.jus.br/api-publica/acesso/
DATAJUD_API_KEY=
# Opcional: chave-api-dados do Portal da Transparência Federal (CGU). Também pode ser configurada em Configurações > Pesquisa Pública (OSINT).
# CGU_API_KEY=
