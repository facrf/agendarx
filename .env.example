SERVER_ADDR=0.0.0.0:12000
DATABASE_URL=sqlite://data/agendarx.db?mode=rwc
JWT_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres
JWT_TTL_MINUTES=480
MAX_UPLOAD_BYTES=26214400
TASK_STORAGE_PER_TASK_BYTES=104857600
TASK_STORAGE_QUOTA_BYTES=1073741824
FRONTEND_DIR=frontend/dist
COOKIE_SECURE=false

# Instância SearXNG com o formato JSON habilitado (a URL pode conter um subcaminho).
# SEARXNG_URL=https://searxng.exemplo.org
# Chave opcional para ampliar os limites da API do OpenAlex.
# OPENALEX_API_KEY=
# Credenciais necessárias somente para pesquisas no INLABS / DOU.
# INLABS_USERNAME=usuario@exemplo.com
# INLABS_PASSWORD=troque-esta-senha
INLABS_LOOKBACK_DAYS=1
OSINT_TIMEOUT_SECONDS=20
OSINT_MAX_RESULTS=15
OSINT_MAX_PDF_BYTES=20971520

# Usados somente para criar o primeiro usuário, caso o login ainda não exista.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=troque-esta-senha

RUST_LOG=agendarx=info,tower_http=info
